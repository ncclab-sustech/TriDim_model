#!/bin/bash
#BSUB -J tridim_batch_3data_2model
#BSUB -q 4v100-16-e5
#BSUB -n 4
#BSUB -gpu "num=1"
#BSUB -R "span[ptile=4]"
#BSUB -e /work/bme-shenxk/xinke/TriDim_small/logs/%J.err
#BSUB -o /work/bme-shenxk/xinke/TriDim_small/logs/%J.out

set -e

echo "Job started at:"
date
echo "Job ID: ${LSB_JOBID}"
echo "Running on host:"
hostname
echo "Working directory:"
pwd

cd ~/xinke/TriDim_small

mkdir -p logs

module load python/anaconda3/2022.10
source activate
conda activate ~/conda_envs/eeg3dim

echo "Python:"
which python
python -V

echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
nvidia-smi || true

DATASETS=(
  "FACED_new"
)

MODELS=(
  "eeg_mixer_v4_outAttentionPoolingFusion"
)

SUMMARY_FILE="logs/${LSB_JOBID}_batch_summary.tsv"

echo -e "dataset\tmodel\tstatus\texit_code\tlog_file" > ${SUMMARY_FILE}

for dataset in "${DATASETS[@]}"
do
  yaml_path="./configs/datasets/${dataset}.yaml"

  if [ ! -f "${yaml_path}" ]; then
    echo "[SKIP] YAML not found: ${yaml_path}"

    for model in "${MODELS[@]}"
    do
      echo -e "${dataset}\t${model}\tYAML_NOT_FOUND\tNA\tNA" >> ${SUMMARY_FILE}
    done

    continue
  fi

  for model in "${MODELS[@]}"
  do
    run_tag="${dataset}_${model}"
    log_file="logs/${LSB_JOBID}_${run_tag}.train.log"

    echo "============================================================"
    echo "[RUN] dataset=${dataset}"
    echo "[RUN] model=${model}"
    echo "[RUN] yaml=${yaml_path}"
    echo "[RUN] log=${log_file}"
    echo "[RUN] start time:"
    date
    echo "============================================================"

    python run.py \
      --model ${model} \
      --data ${dataset} \
      --dataset_paths_yaml ${yaml_path} \
      --itr 5 \
      --seed_start 42 \
      --gpu 0 \
      --gpu_idx 0 \
      > ${log_file} 2>&1

    exit_code=$?

    if [ ${exit_code} -eq 0 ]; then
      echo "[OK] ${dataset} ${model}"
      echo -e "${dataset}\t${model}\tOK\t0\t${log_file}" >> ${SUMMARY_FILE}
    else
      echo "[FAIL] ${dataset} ${model}, exit_code=${exit_code}"
      echo -e "${dataset}\t${model}\tFAIL\t${exit_code}\t${log_file}" >> ${SUMMARY_FILE}
    fi

    echo "[DONE] dataset=${dataset}, model=${model}"
    echo "[DONE] end time:"
    date
  done
done

echo "============================================================"
echo "Batch run finished"
echo "Summary file: ${SUMMARY_FILE}"
cat ${SUMMARY_FILE}
date
echo "============================================================"