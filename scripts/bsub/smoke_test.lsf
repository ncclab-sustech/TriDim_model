#!/bin/bash
#BSUB -J tridim_smoke_3data_2model
#BSUB -q gpu-bme-liuqy
#BSUB -m b07u22g
#BSUB -n 4
#BSUB -gpu "num=1"
#BSUB -R "span[ptile=4]"
#BSUB -e logs/%J.err
#BSUB -o logs/%J.out

set -e

echo "Job started at:"
date
echo "Job ID: ${LSB_JOBID}"
echo "Running on host:"
hostname
echo "Working directory:"
pwd

# 进入你的项目目录；这里请改成你真实的 TriDim 项目路径
cd ~/xinke/TriDim_small

mkdir -p logs

module load python/anaconda3/2022.10
source activate
conda activate ~/conda_envs/eeg3dim

echo "Python:"
which python
python -V

echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
nvidia-smi || true

DATASETS=(
  "AD65_wsn"
  "BCIC2A_wsn"
)

MODELS=(
  "eeg_basis_mixer_v2_nobasis"
  "eeg_mixer_v3_tconv"
)

SUMMARY_FILE="logs/${LSB_JOBID}_smoke_summary.tsv"

echo -e "dataset\tmodel\tstatus\tlog_file" > ${SUMMARY_FILE}

for dataset in "${DATASETS[@]}"
do
  yaml_path="./configs/datasets/${dataset}.yaml"

  if [ ! -f "${yaml_path}" ]; then
    echo "[SKIP] YAML not found: ${yaml_path}"
    for model in "${MODELS[@]}"
    do
      echo -e "${dataset}\t${model}\tYAML_NOT_FOUND\tNA" >> ${SUMMARY_FILE}
    done
    continue
  fi

  for model in "${MODELS[@]}"
  do
    run_tag="${dataset}_${model}_smoke"
    log_file="logs/${LSB_JOBID}_${run_tag}.train.log"

    echo "============================================================"
    echo "[RUN] dataset=${dataset}"
    echo "[RUN] model=${model}"
    echo "[RUN] yaml=${yaml_path}"
    echo "[RUN] log=${log_file}"
    date
    echo "============================================================"

    python run.py \
      --model ${model} \
      --data ${dataset} \
      --dataset_paths_yaml ${yaml_path} \
      --train_epochs 1 \
      --patience 1 \
      --itr 1 \
      --seed_start 42 \
      --gpu 0 \
      --gpu_idx 0 \
      > ${log_file} 2>&1

    exit_code=$?

    if [ ${exit_code} -eq 0 ]; then
      echo "[OK] ${dataset} ${model}"
      echo -e "${dataset}\t${model}\tOK\t${log_file}" >> ${SUMMARY_FILE}
    else
      echo "[FAIL] ${dataset} ${model}, exit_code=${exit_code}"
      echo -e "${dataset}\t${model}\tFAIL_${exit_code}\t${log_file}" >> ${SUMMARY_FILE}
    fi

    echo "Finished ${dataset} ${model}"
    date
  done
done

echo "============================================================"
echo "Smoke test finished"
echo "Summary file: ${SUMMARY_FILE}"
cat ${SUMMARY_FILE}
date
echo "============================================================"