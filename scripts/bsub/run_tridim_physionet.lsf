#!/bin/bash
#BSUB -J tridim_physionet_onlyT
#BSUB -q gpu-bme-liuqy
#BSUB -m b07u22g
#BSUB -n 4
#BSUB -gpu "num=1"
#BSUB -R "span[ptile=4]"
#BSUB -e logs/%J.err
#BSUB -o logs/%J.out

set -e

echo "Job started at:"
date
echo "Job ID: ${LSB_JOBID}"
echo "Running on host:"
hostname
echo "Working directory:"
pwd

# 进入你的项目目录；这里请改成你真实的 TriDim 项目路径
cd ~/xinke/TriDim_small

mkdir -p logs

# 加载 conda 环境；环境名请改成你实际使用的环境，比如 eeg3dim
module load python/anaconda3/2022.10
source activate
conda activate ~/conda_envs/eeg3dim

echo "Python:"
which python
python -V

echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
nvidia-smi || true

python run.py \
  --model eeg_basis_mixer_v2_nobasis_onlyT \
  --data Physionet_MI \
  --dataset_paths_yaml ./configs/datasets/Physionet_MI.yaml \
  --gpu 0 \
  --gpu_idx 0 \
  > logs/${LSB_JOBID}.train.log 2>&1

echo "Job finished at:"
date
